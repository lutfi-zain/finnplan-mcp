{
  "name": "finnplan-mcp",
  "version": "1.0.0",
  "description": "Stateless MCP Server for Eve Finance on Cloudflare Workers (D1)",
  "main": "src/index.ts",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "build": "wrangler deploy --dry-run",
    "test": "tsx --test tests/mcp.test.ts",
    "token:create": "tsx scripts/generate-token.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 execute finance_db --local --file=./drizzle/0000_nice_marvel_boy.sql",
    "db:migrate:remote": "wrangler d1 execute finance_db --remote --file=./drizzle/0000_nice_marvel_boy.sql",
    "test:integration": "bash scripts/run-integration.sh"
  },
  "keywords": [
    "mcp",
    "cloudflare-workers",
    "d1",
    "drizzle-orm",
    "finance"
  ],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.13.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260811.1",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "wrangler": "^4.120.1"
  }
}
